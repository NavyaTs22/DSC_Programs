// Program Dynamically Adds 2 Matrices
#include <stdio.h>

int main() {
  int i,j,a[3][3],b[3][3],r[3][3];
 printf("Enter the elements for A matrix");
 
 for(i=0;i<3;i++){                      // Nested loop for 2D Arrays
     for(j=0;j<3;j++)
     {
         scanf("%d",&a[i][j]);
     }
 }
  printf("Enter the elements for B matrix");
for(i=0;i<3;i++){
     for(j=0;j<3;j++)
     {
         scanf("%d",&b[i][j]);
     }
 }

printf("Addition of a and b matrices are\n");
for(i=0;i<3;i++){
     for(j=0;j<3;j++)
     {
         r[i][j]=a[i][j]+b[i][j];
          printf("%d\t",r[i][j]);
     }
     printf("\n");
 }



    return 0;
} 

